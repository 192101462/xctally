#!/usr/bin/env bash

# ----------------------------------------------------------------------------
#  Hvigor startup script, version 1.0.0
#
#  Required ENV vars:
#  ------------------
#    NODE_HOME - location of a Node home dir
#    or
#    Add /usr/local/nodejs/bin to the PATH environment variable
# ----------------------------------------------------------------------------

HVIGOR_APP_HOME="$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")"
HVIGOR_WRAPPER_SCRIPT=${HVIGOR_APP_HOME}/hvigorw.js
#NODE_OPTS="--max-old-space-size=8192  --expose-gc"

warn() {
	echo ""
	echo -e "\033[1;33m`date '+[%Y-%m-%d %H:%M:%S]'`$@\033[0m"
}

error() {
	echo ""
	echo -e "\033[1;31m`date '+[%Y-%m-%d %H:%M:%S]'`$@\033[0m"
}

fail() {
	error "$@"
	exit 1
}

use_bundled_jre() {
    if [ -d "${DEVECO_JAVA_HOME}/Contents/Home/bin" ]; then
        export PATH="${DEVECO_JAVA_HOME}/Contents/Home/bin:${PATH}"
    elif [ -d "${DEVECO_JAVA_HOME}/bin" ]; then
        export PATH="${DEVECO_JAVA_HOME}/bin:${PATH}"
    fi
}

# JDK resolution: JAVA_HOME first, then bundled JRE
DEVECO_JAVA_HOME="${HVIGOR_APP_HOME}/../../tool/jre"
MIN_JAVA_VERSION=21

if [ -n "${JAVA_HOME}" ] && [ -d "${JAVA_HOME}/bin" ]; then
    # JAVA_HOME is set and valid, check version
    java_version=$("${JAVA_HOME}/bin/java" -version 2>&1 | head -1 | sed 's/.*version "\([^"]*\)".*/\1/')
    major_version=$(echo "$java_version" | cut -d'.' -f1)

    if [ "$major_version" -ge "$MIN_JAVA_VERSION" ] 2>/dev/null; then
        export PATH="${JAVA_HOME}/bin:${PATH}"
    else
        warn "WARNING: The currently configured JDK version is too low (< 21). To ensure compatibility, it has been automatically switched to the embedded JDK 21."
        use_bundled_jre
    fi
else
    # JAVA_HOME not set or invalid, use bundled JRE
    use_bundled_jre
fi

# Determine node to start hvigor wrapper script - try PATH first
EXECUTABLE_NODE="node"
if ! which ${EXECUTABLE_NODE} > /dev/null 2>&1; then
   # node not found in PATH, fall back to NODE_HOME
   if [ -n "${NODE_HOME}" ];then
      if [ -x "${NODE_HOME}/bin/node" ];then
         EXECUTABLE_NODE="${NODE_HOME}/bin/node"
      else
         fail "ERROR: NODE_HOME is set to an invalid directory,check $NODE_HOME\n\nPlease set NODE_HOME in your environment to the location where your nodejs installed"
      fi
   else
      fail "ERROR: NODE_HOME is not set and no 'node' command is found in your PATH setting."
   fi
fi

# Check hvigor wrapper script
if [ ! -r "$HVIGOR_WRAPPER_SCRIPT" ];then
	fail "ERROR: Couldn't find hvigorw.js in ${HVIGOR_APP_HOME}"
fi

if [ -z "${NODE_OPTS}" ]; then
  NODE_OPTS="--"
fi

# start hvigor-wrapper script
exec "${EXECUTABLE_NODE}" "${NODE_OPTS}" \
	"${HVIGOR_WRAPPER_SCRIPT}" "$@"
